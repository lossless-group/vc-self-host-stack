{
  "name": "hubspot-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A client's own OAuth front door to HubSpot's remote MCP server, so Codex and any MCP client (not only Claude) can connect, each person as themselves.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env edviro",
    "deploy": "wrangler deploy --env",
    "types": "wrangler types --env edviro",
    "check": "wrangler types --env edviro && tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
