node_modules
pnpm-lock.yaml
yarn.lock
package-lock.json

# Build / runtime
dist
build
.next
.turbo
.cache

# Docker / local data volumes
docker-data
.local-storage
*.log

# Railway / deploy ephemera
deployment-info.txt
.railway

# Editor / OS
.DS_Store
.idea
.vscode
*.swp
