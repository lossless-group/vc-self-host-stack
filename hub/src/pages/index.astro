---
import { activeClient } from "../config/clients";

const client = activeClient();
const title = `${client.display_name} — Your Tools`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta
      name="description"
      content={`Everything ${client.display_name} runs, in one place.`}
    />
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">Managed for</p>
        <h1>{client.display_name}</h1>
        <p class="lede">
          Your tools, in one place. Bookmark this page — it will always know
          where everything lives.
        </p>
      </header>

      <section class="card">
        <h2>Your CRM</h2>
        <p>
          Your customer relationship manager — people, companies, deals, and
          notes. Sign in with the email and password you were invited with.
        </p>
        <a class="button" href={client.crm_url}>Open your CRM &rarr;</a>
      </section>

      <section class="card">
        <h2>Connect Claude to your CRM</h2>
        <p>
          Two minutes, once, from a computer. After this, Claude can look
          things up and add people to your CRM for you — on your desktop
          <em>and</em> your phone.
        </p>
        <ol>
          <li>
            Open <strong>Claude</strong> (the desktop app or
            <a href="https://claude.ai">claude.ai</a>), click your initials,
            then <strong>Settings &rarr; Connectors</strong>.
          </li>
          <li>
            Click <strong>Add custom connector</strong> and paste this
            address:
            <span class="copyline">
              <code id="mcp-url">{client.mcp_url}</code>
              <button class="copy" data-copy-target="mcp-url" type="button"
                >Copy</button
              >
            </span>
          </li>
          <li>
            Click <strong>Add</strong>. A sign-in page for your CRM opens —
            log in with your CRM email and password and click
            <strong>Approve</strong>.
          </li>
          <li>
            That's it. Ask Claude: <em>"List the companies in my CRM."</em>
            (The first few times, Claude will ask permission to use each
            tool — choose <strong>"Always allow"</strong> and it stops
            asking.)
          </li>
        </ol>
        <details>
          <summary>Prefer to let Claude walk you through it?</summary>
          <p>
            Paste this link into a Claude chat and say
            <em>"Help me set this up"</em>:
          </p>
          <span class="copyline">
            <code id="agent-doc">{client.agent_doc_url}</code>
            <button class="copy" data-copy-target="agent-doc" type="button"
              >Copy</button
            >
          </span>
        </details>
      </section>

      <section class="card muted">
        <h2>Connect ChatGPT</h2>
        <p>
          Coming soon — we're validating the ChatGPT connection flow and will
          add the steps here the moment it's solid. If ChatGPT is your daily
          driver, tell us and we'll bump it up the list.
        </p>
      </section>

      <section class="card">
        <h2>Your didi account <span class="badge">Coming soon</span></h2>
        <p>
          One account for everything on this page — sign in once, and your
          apps, your AI connections, and your settings follow you. We're
          building it now.
        </p>
        <button class="button ghost" type="button" disabled
          >Create your didi account</button
        >
      </section>

      <footer>
        <p>
          Questions, hiccups, ideas? Your operator is one message away.
          Managed by
          <a href="https://www.lossless.group">The Lossless Group</a>.
        </p>
      </footer>
    </main>

    <script>
      for (const button of document.querySelectorAll("button.copy")) {
        button.addEventListener("click", async () => {
          const target = document.getElementById(
            button.getAttribute("data-copy-target"),
          );
          if (!target) return;
          await navigator.clipboard.writeText(target.textContent.trim());
          const original = button.textContent;
          button.textContent = "Copied!";
          setTimeout(() => (button.textContent = original), 1600);
        });
      }
    </script>

    <style>
      :root {
        --bg: #0e1116;
        --surface: #171c24;
        --surface-muted: #131820;
        --text: #e8ecf1;
        --text-dim: #9aa6b4;
        --accent: #6ee7b7;
        --accent-ink: #06281c;
        --border: #232b36;
        --radius: 14px;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          sans-serif;
        line-height: 1.6;
      }
      main {
        max-width: 40rem;
        margin: 0 auto;
        padding: 3rem 1.25rem 4rem;
        display: grid;
        gap: 1.25rem;
      }
      header {
        margin-bottom: 0.5rem;
      }
      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.75rem;
        color: var(--text-dim);
        margin: 0 0 0.25rem;
      }
      h1 {
        font-size: clamp(1.9rem, 5vw, 2.6rem);
        margin: 0 0 0.5rem;
        letter-spacing: -0.02em;
      }
      .lede {
        color: var(--text-dim);
        margin: 0;
        max-width: 34rem;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.5rem 1.5rem 1.6rem;
      }
      .card.muted {
        background: var(--surface-muted);
        color: var(--text-dim);
      }
      .card h2 {
        margin: 0 0 0.5rem;
        font-size: 1.2rem;
      }
      .card p {
        margin: 0 0 0.9rem;
      }
      .card ol {
        margin: 0 0 1rem;
        padding-left: 1.2rem;
        display: grid;
        gap: 0.55rem;
      }
      a {
        color: var(--accent);
      }
      .button {
        display: inline-block;
        background: var(--accent);
        color: var(--accent-ink);
        font-weight: 650;
        text-decoration: none;
        padding: 0.65rem 1.15rem;
        border-radius: 10px;
      }
      .button:hover {
        filter: brightness(1.08);
      }
      .button.ghost {
        background: transparent;
        color: var(--text-dim);
        border: 1px dashed var(--border);
        font: inherit;
        font-weight: 650;
        cursor: default;
      }
      .badge {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--accent);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.15rem 0.55rem;
        vertical-align: middle;
        margin-left: 0.4rem;
      }
      .copyline {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.4rem;
        flex-wrap: wrap;
      }
      code {
        background: #0b0e13;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.35rem 0.6rem;
        font-size: 0.82rem;
        word-break: break-all;
      }
      button.copy {
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.35rem 0.7rem;
        font: inherit;
        font-size: 0.82rem;
        cursor: pointer;
      }
      button.copy:hover {
        border-color: var(--accent);
      }
      details {
        border-top: 1px solid var(--border);
        padding-top: 0.9rem;
      }
      summary {
        cursor: pointer;
        color: var(--text-dim);
      }
      footer {
        color: var(--text-dim);
        font-size: 0.9rem;
        text-align: center;
        margin-top: 0.5rem;
      }
    </style>
  </body>
</html>
